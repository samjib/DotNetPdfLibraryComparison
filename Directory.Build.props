<Project>
  <!-- Shared settings for every project in the solution -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <!-- Only copy English satellite resources (some vendors ship dozens of languages) -->
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <RootNamespace>InvoicePoc</RootNamespace>
  </PropertyGroup>
</Project>
